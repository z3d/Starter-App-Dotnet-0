{
  "realm": "starterapp",
  "enabled": true,
  "accessTokenLifespan": 600,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "registrationAllowed": false,
  "clients": [
    {
      "clientId": "starterapp-dev",
      "name": "StarterApp local development client (well-known credentials — dev only, never deployable)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "local-dev-client-secret-not-a-secret",
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": ["*"],
      "webOrigins": ["*"],
      "defaultClientScopes": [
        "starterapp-api-audience",
        "starterapp-claims",
        "customers:read",
        "customers:write",
        "orders:read",
        "orders:write",
        "products:read",
        "products:write",
        "profile",
        "email"
      ],
      "optionalClientScopes": []
    }
  ],
  "clientScopes": [
    {
      "name": "starterapp-api-audience",
      "description": "Stamps the API audience onto access tokens",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "false" },
      "protocolMappers": [
        {
          "name": "starterapp-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "starterapp-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "name": "starterapp-claims",
      "description": "Deterministic dev claims: tenant id and authentication methods. The hardcoded amr (incl. mfa) mirrors the retired gateway emulator's default dev identity; real deployments must configure the IdP to emit genuine amr values.",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "false" },
      "protocolMappers": [
        {
          "name": "dev-tenant-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "tid",
            "claim.value": "local-dev-tenant",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "dev-amr",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "amr",
            "claim.value": "[\"pwd\",\"mfa\"]",
            "jsonType.label": "JSON",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "name": "customers:read",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" }
    },
    {
      "name": "customers:write",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" }
    },
    {
      "name": "orders:read",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" }
    },
    {
      "name": "orders:write",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" }
    },
    {
      "name": "products:read",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" }
    },
    {
      "name": "products:write",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" }
    }
  ],
  "users": [
    {
      "username": "dev-user",
      "enabled": true,
      "email": "dev-user@example.test",
      "emailVerified": true,
      "firstName": "Dev",
      "lastName": "User",
      "credentials": [
        { "type": "password", "value": "dev-password", "temporary": false }
      ]
    }
  ]
}
