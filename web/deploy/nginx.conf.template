# Rendered by the nginx image's entrypoint (envsubst on ${...}); API_UPSTREAM is the API's base
# URL, e.g. https://api.internal.example.azurecontainerapps.io or http://api:8080.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Never cache the shell or the runtime config; hashed assets can be cached hard.
    location = /index.html { add_header Cache-Control "no-store"; }
    location = /config.js  { root /usr/share/nginx/runtime; add_header Cache-Control "no-store"; }
    location /assets/      { add_header Cache-Control "public, max-age=31536000, immutable"; }

    # Same-origin API: the application calls relative /api/... paths.
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        # An https upstream behind a shared ingress (a container app) routes on SNI; nginx does
        # not send it unless asked, and the handshake is reset without it.
        proxy_ssl_server_name on;
        proxy_ssl_name $proxy_host;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Authorization $http_authorization;
        proxy_read_timeout 120s;
    }

    location = /healthz { return 200 "ok"; add_header Content-Type text/plain; }

    # SPA fallback: /callback and every client route resolve to the shell.
    location / { try_files $uri $uri/ /index.html; }
}
