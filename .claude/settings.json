{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/appsettings.Development.json)",
      "Read(**/appsettings.*.local.json)",
      "Read(**/appsettings.Local.json)",
      "Read(**/*.Local.json)",
      "Read(**/secrets/**)",
      "Read(**/*.pfx)",
      "Read(**/*.pem)",
      "Read(**/*.p12)",
      "Read(**/*.key)",
      "Read(**/*.snk)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/appsettings.Development.json)",
      "Edit(**/appsettings.*.local.json)",
      "Edit(**/appsettings.Local.json)",
      "Edit(**/*.Local.json)",
      "Edit(**/secrets/**)",
      "Edit(**/*.pfx)",
      "Edit(**/*.pem)",
      "Edit(**/*.p12)",
      "Edit(**/*.key)",
      "Edit(**/*.snk)",
      "Edit(**/packages.lock.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "statusMessage": "Guarding against destructive commands",
            "timeout": 15,
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/protect-commands.sh\""
          },
          {
            "type": "command",
            "shell": "bash",
            "timeout": 900,
            "statusMessage": "Pre-commit: format, build, test",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-commit.sh\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "timeout": 20,
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/worktree-cleanup.sh\""
          },
          {
            "type": "command",
            "shell": "bash",
            "timeout": 20,
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/worktree-lifecycle.sh\" start"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "statusMessage": "Checking every worktree ends merged or abandoned",
            "timeout": 20,
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/worktree-lifecycle.sh\""
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "ponytail@ponytail": true
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  }
}
