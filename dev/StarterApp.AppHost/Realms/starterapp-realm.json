{
  "realm": "starterapp",
  "enabled": true,
  "accessTokenLifespan": 3600,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "registrationAllowed": false,
  "clients": [
    {
      "clientId": "starterapp-dev",
      "name": "StarterApp local development client (well-known credentials — dev only, never deployable)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "local-dev-client-secret-not-a-secret",
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": ["*"],
      "webOrigins": ["*"],
      "defaultClientScopes": [
        "starterapp-api-audience",
        "starterapp-claims",
        "profile",
        "email"
      ],
      "optionalClientScopes": [
        "customers:read",
        "customers:write",
        "orders:read",
        "orders:write",
        "products:read",
        "products:write"
      ]
    }
  ],
  "clientScopes": [
    {
      "name": "starterapp-api-audience",
      "description": "Stamps the API audience onto access tokens",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "false" },
      "protocolMappers": [
        {
          "name": "starterapp-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "starterapp-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "name": "starterapp-claims",
      "description": "Deterministic dev claims: username-as-sub, tenant_id attribute -> tid, hardcoded amr incl. mfa. Real IdPs must emit genuine values; rationale and the 1h dev lifespan note live in docs/DECISIONS.md. Keycloak caps this description at 255 chars.",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "false" },
      "protocolMappers": [
        {
          "name": "username-as-sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "username",
            "claim.name": "sub",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "tenant-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tid",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "dev-amr",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "amr",
            "claim.value": "[\"pwd\",\"mfa\"]",
            "jsonType.label": "JSON",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "name": "customers:read",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" }
    },
    {
      "name": "customers:write",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" }
    },
    {
      "name": "orders:read",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" }
    },
    {
      "name": "orders:write",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" }
    },
    {
      "name": "products:read",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" }
    },
    {
      "name": "products:write",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" }
    }
  ],
  "users": [
    {
      "username": "dev-user",
      "enabled": true,
      "email": "dev-user@example.test",
      "emailVerified": true,
      "firstName": "Dev",
      "lastName": "User",
      "attributes": { "tenant_id": ["local-dev-tenant"] },
      "credentials": [
        { "type": "password", "value": "dev-password", "temporary": false }
      ]
    },
    {
      "username": "k6-user",
      "enabled": true,
      "email": "k6-user@example.test",
      "emailVerified": true,
      "firstName": "K6",
      "lastName": "Perf",
      "attributes": { "tenant_id": ["k6-tenant"] },
      "credentials": [
        { "type": "password", "value": "k6-password", "temporary": false }
      ]
    },
    {
      "username": "dast-user-01",
      "enabled": true,
      "email": "dast-user-01@example.test",
      "emailVerified": true,
      "firstName": "Dast",
      "lastName": "One",
      "attributes": { "tenant_id": ["dast-tenant-01"] },
      "credentials": [
        { "type": "password", "value": "dast-password", "temporary": false }
      ]
    },
    {
      "username": "service-account-starterapp-dev",
      "enabled": true,
      "serviceAccountClientId": "starterapp-dev",
      "attributes": { "tenant_id": ["local-dev-tenant"] }
    }
  ]
}
